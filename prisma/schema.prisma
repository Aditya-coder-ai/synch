datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==============================================================================
// ENUMS
// ==============================================================================

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AgentRole {
  COORDINATOR
  DEVELOPER
  QA
  REVIEWER
}

enum AgentStatus {
  ACTIVE
  IDLE
  BUSY
  PAUSED
  ERROR
  OFFLINE
}

enum MessageSenderType {
  HUMAN
  AGENT
  SYSTEM
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  AWAITING_APPROVAL
}

enum MemoryCategory {
  PROJECT_CONTEXT
  USER_PREFERENCE
  DECISION
  TECHNICAL_KNOWLEDGE
  TASK_CONTEXT
  LESSON_LEARNED
}

// ==============================================================================
// MODELS: USERS & WORKSPACES
// ==============================================================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  memberships       WorkspaceMember[]
  assignedTasks     Task[]            @relation("UserAssignedTasks")
  decisions         Decision[]        @relation("UserDecisions")
  reviewedApprovals Approval[]        @relation("UserReviewedApprovals")

  @@index([email])
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members  WorkspaceMember[]
  projects Project[]

  @@index([slug])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
}

// ==============================================================================
// MODELS: PROJECTS
// ==============================================================================

model Project {
  id          String        @id @default(cuid())
  workspaceId String
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  archivedAt  DateTime?

  // Relations
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks         Task[]
  agents        Agent[]
  conversations Conversation[]
  decisions     Decision[]
  approvals     Approval[]
  executions    Execution[]
  memoryEntries MemoryEntry[]

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

// ==============================================================================
// MODELS: TASKS & DEPENDENCIES
// ==============================================================================

model Task {
  id              String       @id @default(cuid())
  projectId       String
  title           String
  description     String?
  status          TaskStatus   @default(BACKLOG)
  priority        TaskPriority @default(MEDIUM)
  assignedUserId  String?
  assignedAgentId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  dueAt           DateTime?
  completedAt     DateTime?

  // Relations
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedUser  User?            @relation("UserAssignedTasks", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedAgent Agent?           @relation("AgentAssignedTasks", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  dependencies  TaskDependency[] @relation("TaskAsSubject")
  dependents    TaskDependency[] @relation("TaskAsDependency")
  executions    Execution[]
  approvals     Approval[]
  decisions     Decision[]
  memoryEntries MemoryEntry[]

  @@index([projectId, status])
  @@index([projectId, priority])
  @@index([assignedUserId])
  @@index([assignedAgentId])
}

model TaskDependency {
  id              String   @id @default(cuid())
  taskId          String
  dependsOnTaskId String
  createdAt       DateTime @default(now())

  // Relations
  task          Task @relation("TaskAsSubject", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask Task @relation("TaskAsDependency", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
}

// ==============================================================================
// MODELS: AGENTS
// ==============================================================================

model Agent {
  id            String      @id @default(cuid())
  projectId     String
  name          String
  role          AgentRole   @default(DEVELOPER)
  description   String?
  status        AgentStatus @default(IDLE)
  capabilities  Json        @default("[]")
  configuration Json        @default("{}")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  project            Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTasks      Task[]      @relation("AgentAssignedTasks")
  executions         Execution[]
  requestedApprovals Approval[]
  decisions          Decision[]

  @@index([projectId, status])
  @@index([projectId, role])
}

// ==============================================================================
// MODELS: CONVERSATIONS & MESSAGES
// ==============================================================================

model Conversation {
  id             String   @id @default(cuid())
  projectId      String
  title          String
  externalRoomId String?  @unique
  source         String   @default("internal")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([projectId, createdAt])
  @@index([externalRoomId])
}

model Message {
  id                String            @id @default(cuid())
  conversationId    String
  senderType        MessageSenderType
  senderId          String?
  content           String
  externalMessageId String?           @unique
  metadata          Json              @default("{}")
  createdAt         DateTime          @default(now())

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderType, senderId])
  @@index([externalMessageId])
}

// ==============================================================================
// MODELS: SWITCH INTEGRATION & EVENT DEDUPLICATION
// ==============================================================================

model SwitchEventLog {
  id          String   @id @default(cuid())
  eventId     String   @unique
  eventType   String
  roomId      String
  senderId    String?
  processedAt DateTime @default(now())
  status      String   @default("PROCESSED") // PROCESSED, DUPLICATE, UNMAPPED_ROOM, ERROR
  payload     Json     @default("{}")

  @@index([roomId, eventId])
  @@index([processedAt])
}

// ==============================================================================
// MODELS: PROJECT DECISIONS
// ==============================================================================

model Decision {
  id               String   @id @default(cuid())
  projectId        String
  taskId           String?
  title            String
  description      String
  rationale        String
  decidedByUserId  String?
  decidedByAgentId String?
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now())

  // Relations
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task           Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  decidedByUser  User?   @relation("UserDecisions", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedByAgent Agent?  @relation(fields: [decidedByAgentId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([taskId])
}

// ==============================================================================
// MODELS: HUMAN APPROVALS
// ==============================================================================

model Approval {
  id                 String         @id @default(cuid())
  projectId          String
  taskId             String?
  executionId        String?
  requestedByAgentId String?
  actionType         String
  description        String
  status             ApprovalStatus @default(PENDING)
  payload            Json           @default("{}")
  reviewedByUserId   String?
  reviewedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Relations
  project          Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task             Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  execution        Execution? @relation(fields: [executionId], references: [id], onDelete: SetNull)
  requestedByAgent Agent?     @relation(fields: [requestedByAgentId], references: [id], onDelete: SetNull)
  reviewedByUser   User?      @relation("UserReviewedApprovals", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([taskId])
  @@index([executionId])
}

// ==============================================================================
// MODELS: EXECUTION TRACKING
// ==============================================================================

model Execution {
  id          String          @id @default(cuid())
  projectId   String
  taskId      String
  agentId     String
  status      ExecutionStatus @default(QUEUED)
  input       Json            @default("{}")
  output      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent     Agent            @relation(fields: [agentId], references: [id], onDelete: Restrict)
  events    ExecutionEvent[]
  approvals Approval[]

  @@index([projectId, status])
  @@index([taskId, status])
  @@index([agentId, status])
}

model ExecutionEvent {
  id          String   @id @default(cuid())
  executionId String
  eventType   String
  message     String
  payload     Json     @default("{}")
  createdAt   DateTime @default(now())

  // Relations
  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt])
}

// ==============================================================================
// MODELS: PERSISTENT MEMORY
// ==============================================================================

model MemoryEntry {
  id         String         @id @default(cuid())
  projectId  String
  taskId     String?
  category   MemoryCategory @default(PROJECT_CONTEXT)
  title      String
  content    String
  sourceType String
  sourceId   String?
  metadata   Json           @default("{}")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([projectId, category])
  @@index([taskId])
  @@index([sourceType, sourceId])
}
