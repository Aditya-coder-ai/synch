# ==============================================================================
# CrewFlow Backend - Environment Configuration Example
# ==============================================================================

# Server Environment & Network
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Cross-Origin Resource Sharing (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Request Body Limit in bytes (1048576 = 1MB)
BODY_LIMIT=1048576

# Supabase PostgreSQL Connection
# Pooled connection string (Transaction mode, typically port 6543) for runtime queries
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crewflow?schema=public"

# Direct connection string (Session mode, port 5432) for Prisma migrations
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/crewflow?schema=public"

